{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PROJET_NOM": "sweep",
    "PROJET_BACK": "backend",
    "PROJET_FRONT": "",
    "PROJET_ENV_TEST": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
